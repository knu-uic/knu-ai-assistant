{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KNU Server Manager",
  "version": "0.1.0",
  "identifier": "kr.ac.kongju.knu-server-manager",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1421", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "KNU Server Manager", "width": 1220, "height": 800, "minWidth": 980, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false }
}
