# KNU_SITE_ADDRESS를 실제 DNS 도메인으로 설정하면 Caddy가 TLS 인증서를 자동 발급한다.
{$KNU_SITE_ADDRESS} {
	root * /srv
	encode gzip

	# Server Manager 관리자 API는 호스팅 서버의 공용 진입점으로 노출하지 않는다.
	handle /api/admin* {
		respond "Not Found" 404
	}

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# SPA: 요청 경로에 실제 파일이 없으면 index.html로 폴백.
	handle {
		try_files {path} /index.html
		file_server
	}
}
