# Providers
# available options: lmstudio, google, gemini, openai
VLM_PROVIDER=lmstudio
EMBEDDING_PROVIDER=lmstudio

#DB
DB_PASSWORD=
DB_NAME=knu-uic
DB_USER=knu-uic
DB_HOST=localhost
DB_PORT=5432

# Models
LLM_MODEL=gemma-4-e4b
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3


# LM Studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Config
# 실제 LM Studio / llama.cpp 모델 로드시 사용할 최대 컨텍스트 윈도우 값
# (앱 내부 RAG budget과는 별개)
LLM_MAX_CONTEXT_WINDOW_TOKENS=60000

RERANKER_MAX_LENGTH=512

# retrieval pipeline
# vector search 후보 chunk 수
RERANK_CANDIDATES=80

# rerank 후 evidence로 직접 answer prompt에 넣을 chunk 수
RERANK_TOP_N=8

# support document packing 수
SUPPORT_DOC_TOP_N=3

# answerer가 실제로 prompt에 stuffing할 최대 문자 수
ANSWER_CONTEXT_CHAR_BUDGET=12000

# refine 단계에서 사용할 최대 문자 수
# body_content 우선 사용
# body가 빈약하면 attachment excerpt fallback 일부 포함
REFINE_FULL_CONTENT_LIMIT=12000


# verifier 단계 사용 여부
# false 권장 (현재 rerank + evidence 구조에서 비용 대비 효율 낮음)
ENABLE_VERIFIER=false

# API Keys
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
