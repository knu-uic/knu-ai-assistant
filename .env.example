# Runtime
# local | docker
RUNTIME_ENV=docker


# Providers
# available options: local, google, openai, jina
VLM_PROVIDER=local
EMBEDDING_PROVIDER=local
RERANKER_PROVIDER=local

# Local OpenAI-compatible server port
# LM Studio: 1234
# Ollama: 11434
# vLLM: 8000
LOCAL_LLM_PORT=1234
# 구조화 추출은 재현성을 위해 온도 0을 권장한다.
LOCAL_LLM_TEMPERATURE=0
# 로컬 모델이 stop token을 누락해도 워커가 무한 대기하지 않도록 제한
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TIMEOUT_SECONDS=180

#DB
DB_PASSWORD=
DB_NAME=knu-uic
DB_USER=knu-uic
DB_PORT=5432

# Models
LLM_MODEL=gemma-4-12b-it-mlx
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Config
# 실제 LM Studio / llama.cpp 모델 로드시 사용할 최대 컨텍스트 윈도우 값
# (앱 내부 RAG budget과는 별개)
LLM_MAX_CONTEXT_WINDOW_TOKENS=32768

RERANKER_MAX_LENGTH=512

# retrieval pipeline
RERANK_CANDIDATES=80  #vector search 후보 chunk 수
RERANK_TOP_N=8  #rerank 후 evidence로 직접 answer prompt에 넣을 chunk 수
SUPPORT_DOC_TOP_N=3  #support document packing 수

# 임베딩 차원
EMBEDDING_DIM=768
# answerer가 실제로 prompt에 stuffing할 최대 문자 수
ANSWER_CONTEXT_CHAR_BUDGET=12000

# refine 단계에서 사용할 최대 문자 수
# body_content 우선 사용
# body가 빈약하면 attachment excerpt fallback 일부 포함
REFINE_FULL_CONTENT_LIMIT=24000
ATTACHMENT_REFINE_FALLBACK_CHARS=16000


# verifier 단계 사용 여부
# false 권장 (현재 rerank + evidence 구조에서 비용 대비 효율 낮음)
ENABLE_VERIFIER=false

# API Keys
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
JINA_API_KEY=
