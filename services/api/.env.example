# KNU AI Assistant — 환경변수 예시.
# 이 파일을 .env로 복사한 뒤 값을 채워 사용한다. (.env는 git에 올리지 않음)
#   cp .env.example .env

# ─────────────────────────────────────────────
# 런타임
# ─────────────────────────────────────────────
# local | docker — docker면 DB_HOST=db, LLM은 host.docker.internal로 연결
RUNTIME_ENV=local
# 로컬 OpenAI 호환 LLM(LM Studio 등) 포트
LOCAL_LLM_PORT=1234
# Gemma 구조화 추출 권장값. LM Studio에서도 같은 모델을 32768 context로 load한다.
LLM_MAX_CONTEXT_WINDOW_TOKENS=32768
LOCAL_LLM_TEMPERATURE=0
# 공지 분류·요약 구조화 요청은 내부 추론을 사용하지 않는다.
# 코드는 LM Studio 요청에 enable_thinking=false를 명시한다.
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TIMEOUT_SECONDS=180
REFINE_FULL_CONTENT_LIMIT=24000
ATTACHMENT_REFINE_FALLBACK_CHARS=16000

# ─────────────────────────────────────────────
# 데이터베이스 (PostgreSQL + pgvector)
# ─────────────────────────────────────────────
DB_USER=knu-uic
DB_PASSWORD=change-me
DB_NAME=knu-uic
DB_PORT=5432
# 전체 연결 문자열을 직접 줄 경우(있으면 위 DB_* 대신 사용)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_POOL_MAX=10
# pgvector 스키마의 임베딩 차원과 반드시 일치 (없거나 정수 아니면 기동 실패)
EMBEDDING_DIM=1536

# ─────────────────────────────────────────────
# Redis (Arq 워커 잡큐 · 레이트리밋 · LMS 세션)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# 모델 프로바이더 (prod 기본 OpenAI / 로컬 토글)
# VLM/EMBEDDING_PROVIDER: local | openai | google
# RERANKER_PROVIDER: local | jina
# ─────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
VLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_PROVIDER=jina
RERANKER_MODEL=
OPENAI_API_KEY=sk-...
# google provider로 바꿀 때
GOOGLE_API_KEY=
GEMINI_API_KEY=
# jina 리랭커 사용 시
JINA_API_KEY=

# 문서 내부 그림 OCR·설명과 원본 asset 저장
# 이전 HWP_IMAGE_ANALYSIS_ENABLED/HWP_ASSETS_ROOT도 호환됩니다.
DOCUMENT_IMAGE_ANALYSIS_ENABLED=false
DOCUMENT_ASSETS_ROOT=data/assets

# ─────────────────────────────────────────────
# 인증 (자체 계정 JWT)
# ─────────────────────────────────────────────
# 32자 이상 무작위 문자열. 생성: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_DAYS=30
# 가입 허용 학교 메일 도메인
SIGNUP_EMAIL_DOMAIN=smail.kongju.ac.kr

# 내부 MCP 공지 근거 조회 전용 Bearer token. 외부 공개용이 아니며 tool 인자로 전달하지 않음.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# ─────────────────────────────────────────────
# 가입 인증 메일
# MAIL_PROVIDER: gmail | resend | console
#   - 미설정/console: 코드를 서버 로그에 출력(로컬 개발)
#   - gmail: GMAIL_USER + 앱 비밀번호 필요
#   - resend: RESEND_API_KEY + 도메인 인증된 MAIL_FROM 필요
# ─────────────────────────────────────────────
MAIL_PROVIDER=console
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=

# ─────────────────────────────────────────────
# 포털/LMS 동기화 (비밀번호 잡 전달 암호화 · LMS 세션)
# ─────────────────────────────────────────────
# Fernet 키. 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PORTAL_SYNC_ENC_KEY=
PORTAL_SYNC_TIMEOUT_SECONDS=180
LMS_SESSION_TTL_DAYS=7
# LMS(Canvas) 직접 토큰 — 보통은 동기화 로그인으로 발급되므로 비워둠
KNU_LMS_URL=https://knulms.kongju.ac.kr
# CANVAS_ACCESS_TOKEN=
# KNU_LMS_TOKEN=

# ─────────────────────────────────────────────
# 워커 (공지 폴링 cron)
# ─────────────────────────────────────────────
# 공지 증분 수집 주기(분). 60의 약수
NOTICE_POLL_MINUTES=20
# Server Manager는 아래 JSON 설정의 1/6/12/24시간 주기를 우선합니다.
NOTICE_POLL_ENABLED=true
NOTICE_POLL_HOURS=6
KNU_MANAGER_SETTINGS_PATH=
# 원격 관리 API를 열 때는 반드시 긴 임의 문자열로 설정하세요.
KNU_ADMIN_TOKEN=

# ─────────────────────────────────────────────
# 레이트리밋 (없으면 코드 기본값)
# ─────────────────────────────────────────────
RATE_LIMIT_SIGNUP_REQUEST=3/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=5/minute;150/day
RATE_LIMIT_READ=30/minute
RATE_LIMIT_POLL=120/minute
RATE_LIMIT_MCP=60/minute

# ─────────────────────────────────────────────
# 웹 / 앱
# ─────────────────────────────────────────────
# 웹 SPA 오리진(콤마 구분). 비면 CORS 미들웨어 미적용(개발=vite proxy)
# 예: https://knupick.example.com,http://localhost:5173
WEB_CORS_ORIGINS=
# 이 버전 미만 앱은 시작 시 강제 업데이트 안내
MIN_APP_VERSION=1.0.0

# ─────────────────────────────────────────────
# 관측 (LangSmith) — 선택
# ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knu-ai-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
