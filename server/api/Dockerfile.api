# prod api 슬림 이미지.
# 기존 Dockerfile(worker용 헤비)과 분리 — api는 크롤링/문서변환을 안 하므로
# poppler·JRE·playwright 같은 worker 시스템 패키지와 torch가 전부 불필요하다.
FROM node:22.23.1-bookworm-slim AS context-node
FROM python:3.12-slim

WORKDIR /app
COPY --from=context-node /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/* && node --version

# API 파이썬 패키지 설치 (worker의 OCR/브라우저 런타임은 포함하지 않음).
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
RUN playwright install --with-deps chromium

# 앱 소스 복사. .env·.secrets·캐시·빌드 부산물은 .dockerignore로 제외된다.
COPY . .

EXPOSE 8000

# FastAPI api 서버. DB 호스트는 compose가 RUNTIME_ENV=docker로 'db'를 가리키게 하고,
# REDIS_URL은 compose가 redis://redis:6379로 주입한다.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
