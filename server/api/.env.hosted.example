# 공개 DNS 이름. 예: knu.example.org (http:// 또는 https://를 붙이지 않음)
KNU_SITE_ADDRESS=knu.example.org
WEB_CORS_ORIGINS=https://knu.example.org

# 데이터베이스·인증 비밀값. 운영 시 각각 독립된 긴 임의값으로 교체한다.
DB_USER=knu-uic
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=knu-uic
AUTH_JWT_SECRET=replace-with-a-long-random-jwt-secret
PORTAL_SYNC_ENC_KEY=replace-with-a-fernet-key
KNU_ADMIN_TOKEN=replace-with-a-long-random-admin-token
MCP_AUTH_TOKEN=replace-with-a-long-random-internal-token

# 운영 AI provider. 로컬 Ollama/LM Studio 주소는 컨테이너에서 접근할 수 있어야 한다.
VLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_PROVIDER=jina
JINA_API_KEY=

DOCUMENT_IMAGE_ANALYSIS_ENABLED=true
DOCUMENT_ASSETS_ROOT=data/assets
NOTICE_POLL_ENABLED=true
NOTICE_POLL_HOURS=6
