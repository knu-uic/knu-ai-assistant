# 정적 파일 서빙 + API 프록시. 도메인 생기면 ':80'을 도메인으로 바꾸면 Caddy가 HTTPS 자동 발급.
:80 {
	root * /srv
	encode gzip

	# /api/* 는 같은 도커 네트워크의 api 컨테이너로 프록시.
	# (개발 중 vite proxy가 /api → :8000 하던 것과 동일 동작)
	# api는 /api 프리픽스로 라우팅하므로 경로 재작성 없이 그대로 전달.
	handle /api/* {
		reverse_proxy api:8000
	}

	# SPA: 요청 경로에 실제 파일이 없으면 index.html로 폴백.
	handle {
		try_files {path} /index.html
		file_server
	}
}

:8000 {
	@mcp path /api/mcp*
	handle @mcp {
		reverse_proxy api:8000 {
			header_up Authorization "Bearer {$MCP_AUTH_TOKEN}"
		}
	}

	respond "Not Found" 404
}
